{
  "id": "pure-bff-demo",
  "realm": "pure-bff-demo",
  "displayName": "Pure BFF Demo Realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "roles": {
    "realm": [
      {
        "id": "role-admin",
        "name": "admin",
        "description": "Administrator Role"
      },
      {
        "id": "role-user",
        "name": "user",
        "description": "Standard User Role"
      }
    ]
  },
  "defaultRoles": [
    "user"
  ],
  "clients": [
    {
      "id": "client-bff-app",
      "clientId": "bff-client",
      "name": "BFF Fastify Client",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "bff-secret-super-secure-change-in-prod",
      "redirectUris": [
        "http://localhost:3000/api/auth/callback",
        "http://localhost:5173/*",
        "http://localhost:5173/login"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://localhost:3000",
        "+"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:5173/*##http://localhost:5173/login##http://localhost:3000/*",
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "users": [
    {
      "id": "user-demo-01",
      "username": "demo",
      "email": "demo@example.com",
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "id": "user-admin-01",
      "username": "admin",
      "email": "admin@example.com",
      "firstName": "Super",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin",
        "user"
      ]
    }
  ]
}
