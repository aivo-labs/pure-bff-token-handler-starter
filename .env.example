# ==============================================================================
# Pure BFF & Token Handler Starter - Environment Configuration
# 
# ⚠️ WARNING: DO NOT DEPLOY DEFAULT VALUES TO PRODUCTION!
# Apply the security instructions below before any production deployment.
# ==============================================================================

# BFF Server Config
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# ------------------------------------------------------------------------------
# Session & Cookie Security
# ------------------------------------------------------------------------------
# ⚠️ MUST CHANGE IN PRODUCTION: Generate with `openssl rand -hex 32` (min 32 bytes)
SESSION_SECRET=starter_secret_key_must_be_32_bytes_long_min!
COOKIE_NAME=bff_session
# ⚠️ CRITICAL: Must be "true" in production! "false" is strictly for local HTTP testing.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# Application URLs (HTTPS required in production)
# ------------------------------------------------------------------------------
# ⚠️ DEV ONLY: Replace with your real frontend domain (e.g. https://app.example.com)
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# OIDC Identity Provider (Keycloak / Authelia / Okta)
# ------------------------------------------------------------------------------
# Browser-facing URL (User redirection to IAM login screen)
# ⚠️ DEV ONLY: Replace with your public HTTPS IAM domain (e.g. https://auth.example.com)
OIDC_ISSUER_URL=http://localhost:8080

# Internal network URL (BFF backchannel calls: token exchange, userinfo, revocation)
# In Docker/K8s, point to internal service (e.g. http://keycloak:8080 or internal mesh)
OIDC_INTERNAL_ISSUER_URL=http://keycloak:8080

KEYCLOAK_REALM=pure-bff-demo
OIDC_CLIENT_ID=bff-client
# ⚠️ MUST CHANGE IN PRODUCTION: Generate a strong client secret in Keycloak!
OIDC_CLIENT_SECRET=bff-secret-super-secure-change-in-prod

# ⚠️ DEV ONLY: Update to production callback URL (e.g. https://api.example.com/api/auth/callback)
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ------------------------------------------------------------------------------
# PostgreSQL Persistence
# ------------------------------------------------------------------------------
# ⚠️ DEV ONLY: Replace default credentials and avoid hardcoded secrets in version control
DATABASE_URL=postgres://keycloak:password@postgres:5432/keycloak
